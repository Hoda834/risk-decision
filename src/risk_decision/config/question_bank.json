    "validation": { "min_length": 2, "max_length": 800 }
  },
  {
    "id": "Q15",
    "step": "definition",
    "text": "Which documents or records support this?",
    "input_type": "textarea",
    "required": true,
    "path": "definition.references",
    "validation": { "min_length": 2, "max_length": 800 }
  },
  {
    "id": "Q16",
    "step": "likelihood",
