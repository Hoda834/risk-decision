[
  {
    "id": "Q1",
    "step": "anchor",
    "text": "What is this case anchored to?",
    "input_type": "single_select",
    "required": true,
    "path": "anchor.anchor_type",
    "options_from_enum": "AnchorType",
    "checkpoint": "after_anchor_type"
  },
  {
    "id": "Q2",
