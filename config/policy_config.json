{
  "policy_version": "v1.1",
  "scales": {
    "likelihood": {
      "type": "ordinal",
      "labels": {
        "1": "rare",
        "2": "unlikely",
        "3": "possible",
        "4": "likely",
        "5": "almost certain"
      },
      "normalisation": {
        "method": "minmax",
        "min": 1,
        "max": 5
      }
    },
    "impact": {
      "type": "ordinal",
      "labels": {
        "1": "minimal",
        "2": "minor",
        "3": "moderate",
        "4": "major",
        "5": "catastrophic"
      },
      "normalisation": {
        "method": "minmax",
        "min": 1,
        "max": 5
      }
    }
  },
  "scoring": {
    "method": "multiply",
    "rounding": {
      "decimals": 4
    }
  },
  "thresholds": {
    "acceptance_threshold": 0.5,
    "hard_accept_block_threshold": 0.7,
    "categories": [
      { "name": "low", "min": 0.0, "max": 0.2 },
      { "name": "medium", "min": 0.2, "max": 0.5 },
      { "name": "high", "min": 0.5, "max": 0.8 },
      { "name": "critical", "min": 0.8, "max": 1.01 }
    ]
  },
  "overrides": {
    "catastrophic_impact": {
      "if_impact_level_gte": 5,
      "floor_category": "high",
      "reason": "A catastrophic worst credible outcome cannot be classified below high."
    },
    "irreversible_impact": {
      "if_reversibility_in": ["Irreversible"],
      "floor_category": "medium",
      "reason": "An irreversible outcome cannot be classified below medium."
    },
    "privacy_signal": {
      "if_text_contains": ["monitoring", "biometric", "children", "health", "location", "cctv"],
      "search_paths": ["definition.event", "definition.consequences", "impact.worst_credible_outcome"],
      "floor_category": null,
      "reason": "Personal data signals require approval even at a low score."
    }
  },
  "decision_policy": {
    "by_category": {
      "low": "ACCEPT",
      "medium": "REDUCE",
      "high": "REDUCE",
      "critical": "AVOID"
    },
    "constraints": {
      "accept_requires_rationale": true,
      "accept_requires_owner": true,
      "override_requires_note": true
    }
  },
  "escalation": {
    "require_approval_if": {
      "score_gte": 0.5,
      "any_override_applied": true
    },
    "authority_matrix": [
      { "role": "risk_owner", "max_score_to_accept": 0.2 },
      { "role": "security_lead", "max_score_to_accept": 0.5 },
      { "role": "management", "max_score_to_accept": 0.7 }
    ]
  }
}
